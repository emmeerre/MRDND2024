/* ---------- input: pedine e pareti ---------- */
function shade(hex,f){
  const n=parseInt(hex.slice(1),16);
  const r=clamp(Math.round(((n>>16)&255)*f),0,255),
        g=clamp(Math.round(((n>>8)&255)*f),0,255),
        b=clamp(Math.round((n&255)*f),0,255);
  return`rgb(${r},${g},${b})`;
}
function pickPawn(wx,wy){
  for(let k=pawns.length-1;k>=0;k--){
    const p=pawns[k];
    if(Math.hypot(wx-p.fx,wy-p.fy)<.45)return p;
  }
  return null;
}
/* parete più vicina al cursore, tolleranza stretta */
function pick(wx,wy){
  const PX=wx*CELL,PY=wy*CELL;
  let best=null,bd=Infinity;
  for(const w of bars){
    if(w.anim)continue;
    const [ax,ay,bx,by]=endpoints(w.o,w.i,w.j);
    const d=segDist(PX,PY,ax*CELL,ay*CELL,bx*CELL,by*CELL);
    if(d<bd){bd=d;best=w;}
  }
  if(!best||bd>WALL_T/2+3)return null;
  const ang=best.o==='h'?0:Math.PI/2;
  const dx=wx-best.x,dy=wy-best.y;
  const t=dx*Math.cos(ang)+dy*Math.sin(ang);
  const zone=Math.abs(t)<=ROT_HALF?'rot':(t<0?'neg':'pos');
  return{w:best,t,zone,hingeA:t<0};
}
function pokeSand(){
  stir.t=0;
  ripples.push({x:CI*CELL,y:CJ*CELL,t:0,sand:true,max:CELL*2.2});
  sfx.sand();
}
cv.addEventListener('pointerdown',e=>{
  sfx.ensure();lastUser=timeS;
  if(e.button!==0&&e.button!==2)return;
  const wx=(e.clientX-OX)/CELL,wy=(e.clientY-OY)/CELL;
  /* 1) pedine (solo tasto sinistro) */
  if(e.button===0){
    const pp=pickPawn(wx,wy);
    if(pp){
      selP=pp;pp.anim=null;pp.bump=null;
      dragP={p:pp,ox:wx-pp.fx,oy:wy-pp.fy};
      cv.style.cursor='grabbing';
      return;
    }
  }
  /* 2) pareti */
  const cw=e.button===2;
  const h=pick(wx,wy);
  if(h){
    const w=h.w;let ok=false;
    if(h.zone==='rot'){
      ok=tryRotate(w,cw,1,h.hingeA);
      if(!ok)blocked(w);
    }else{
      const dir=h.zone==='pos'?1:-1;
      ok=trySlide(w,dir,1)||trySlide(w,-dir,1);
      if(!ok)blocked(w);
    }
    if(ok)userMoves++;
    return;
  }
  if(Math.hypot(wx-CI,wy-CJ)<NEST_R+.2){pokeSand();return;}
  ripples.push({x:wx*CELL,y:wy*CELL,t:0,max:30});
});
cv.addEventListener('pointermove',e=>{
  const wx=(e.clientX-OX)/CELL,wy=(e.clientY-OY)/CELL;
  if(dragP){
    /* drag libero: niente griglia, niente muri, niente bordi */
    dragP.p.fx=wx-dragP.ox;dragP.p.fy=wy-dragP.oy;
    hover=null;cv.style.cursor='grabbing';
    return;
  }
  const pp=pickPawn(wx,wy);
  hover=pp?null:pick(wx,wy);
  if(pp){cv.style.cursor='grab';return;}
  if(!hover&&Math.hypot(wx-CI,wy-CJ)<NEST_R){cv.style.cursor='pointer';return;}
  cv.style.cursor=hover?'grab':'default';
});
window.addEventListener('pointerup',e=>{
  if(dragP){
    const p=dragP.p;
    const wx=(e.clientX-OX)/CELL,wy=(e.clientY-OY)/CELL;
    /* snap esatto sulla casella più vicina (libera), dentro i limiti */
