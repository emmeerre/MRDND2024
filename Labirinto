  ctx.fillStyle='rgba(255,205,130,.06)';ctx.fill();
  ctx.strokeStyle='rgba(235,190,120,.75)';ctx.lineWidth=1.4;ctx.stroke();
  if(hover.zone==='rot'){
    ctx.strokeStyle='rgba(240,205,140,.9)';ctx.lineWidth=1.6;
    ctx.beginPath();ctx.arc(0,0,4.2,0,TAU);ctx.stroke();
    ctx.fillStyle='rgba(240,205,140,.9)';
    ctx.beginPath();ctx.arc(0,0,1.3,0,TAU);ctx.fill();
  }else{
    const s=hover.zone==='pos'?1:-1;
    ctx.strokeStyle='rgba(240,205,140,.9)';ctx.lineWidth=1.6;ctx.lineCap='round';
    ctx.beginPath();ctx.moveTo(s*(L/2+2),0);ctx.lineTo(s*(L/2+11),0);ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(s*(L/2+13),0);
    ctx.lineTo(s*(L/2+8),-3.6);
    ctx.lineTo(s*(L/2+8),3.6);
    ctx.closePath();
    ctx.fillStyle='rgba(240,205,140,.9)';ctx.fill();
  }
  ctx.restore();
}
function drawPawn(p){
  const R=CELL*.34;
  let x=p.fx*CELL,y=p.fy*CELL;
  if(p.bump){
    const off=Math.sin(clamp(p.bump.t,0,1)*Math.PI)*.1;
    x+=p.bump.dx*off*CELL;y+=p.bump.dy*off*CELL;
  }
  /* ombra */
  ctx.fillStyle='rgba(0,0,0,.35)';
  ctx.beginPath();ctx.ellipse(x+2,y+3,R*.95,R*.78,0,0,TAU);ctx.fill();
  /* corpo */
  const gr=ctx.createRadialGradient(x-R*.35,y-R*.4,R*.15,x,y,R);
  gr.addColorStop(0,shade(p.def.col,1.4));
  gr.addColorStop(.55,p.def.col);
  gr.addColorStop(1,shade(p.def.col,.7));
  ctx.beginPath();ctx.arc(x,y,R,0,TAU);
  ctx.fillStyle=gr;ctx.fill();
  ctx.lineWidth=Math.max(1.2,CELL*.045);
  ctx.strokeStyle='rgba(22,11,4,.55)';ctx.stroke();
  ctx.beginPath();ctx.arc(x,y,R*.76,0,TAU);
  ctx.strokeStyle='rgba(0,0,0,.16)';ctx.lineWidth=1;ctx.stroke();
  /* lettere (1-3) */
  const txt=p.def.txt||'';
  if(txt){
    const fs=Math.min(R*1.1,R*2.4/Math.max(1,txt.length));
    ctx.font=`700 ${fs}px 'IBM Plex Mono',monospace`;
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillStyle='rgba(0,0,0,.3)';
    ctx.fillText(txt,x+1,y+1.5);
    ctx.fillStyle='#241408';
    ctx.fillText(txt,x,y+R*.05);
  }
  /* selezione */
  if(p===selP){
    ctx.beginPath();
    ctx.arc(x,y,R+3.5+Math.sin(timeS*4)*.8,0,TAU);
    ctx.strokeStyle='rgba(240,205,140,.9)';ctx.lineWidth=1.6;ctx.stroke();
  }
}

/* ---------- ciclo principale ---------- */
let last=0;
function frame(ts){
  requestAnimationFrame(frame);
  const t=ts/1000,dt=Math.min(.05,t-(last||t));
  last=t;timeS=t;

  for(const w of bars){
    w.shud=Math.max(0,w.shud-dt*5);
    if(w.anim){
      const A=w.anim;A.t+=dt/A.dur;
      if(A.t<1&&A.type==='rot'&&Math.random()<dt*25){
        const X=wallXform(w);
        dustAt((2*X.x-A.ax)*CELL,(2*X.y-A.ay)*CELL,1);
      }
      if(A.t>=1){
        w.anim=null;
        sfx.clack(A.vol);
        addShake(A.vol>.6?2:.8);
        dustAtEnds(w,3);
        if(A.vol>.6)ripples.push({x:CI*CELL,y:CJ*CELL,t:0,sand:true,max:CELL*1.6});
      }
    }
  }
  /* pedine: animazioni di movimento/atterraggio */
  for(const p of pawns){
    if(p.anim){
      const A=p.anim;A.t+=dt/A.dur;
      const k=eoc(clamp(A.t,0,1));
      p.fx=A.fx+(A.tx-A.fx)*k;p.fy=A.fy+(A.ty-A.fy)*k;
      if(A.t>=1){p.fx=A.tx;p.fy=A.ty;p.anim=null;}
    }
    if(p.bump){p.bump.t+=dt/.16;if(p.bump.t>=1)p.bump=null;}
  }
  /* vita autonoma delle pareti */
  idleT-=dt;
  if(idleT<=0){
    idleT=rnd(1.5,4.5);
    if(!RM&&timeS-lastUser>2.5){
      for(let k=0;k<10;k++){
        const w=bars[irand(bars.length)];
        if(!w||w.anim)continue;
        const ok=Math.random()<.5
          ?tryRotate(w,Math.random()<.5,.3,Math.random()<.5)
          :trySlide(w,Math.random()<.5?1:-1,.3);
        if(ok)break;
      }
    }
  }
  for(const g of grains){
    g.r-=g.sp*dt*(.35+g.r/(NEST_R*CELL));
    if(g.r<CELL*.35){g.r=NEST_R*CELL*rnd(.88,.97);g.a=rnd(TAU);}
  }
  stir.t-=dt;
  if(stir.t<=0){stir.t=rnd(6,11);stir.s=1;sfx.sand();}
  stir.s=Math.max(0,stir.s-dt*1.6);
  if(stir.s>.5&&Math.random()<dt*30){
    const a=rnd(TAU);
    dust.push({x:CI*CELL+Math.cos(a)*CELL*.5,y:CJ*CELL+Math.sin(a)*CELL*.5,
      vx:Math.cos(a)*rnd(20,60),vy:Math.sin(a)*rnd(20,60),t:0,life:rnd(.3,.6),r:rnd(.8,1.6)});
  }
  lurkA+=dt*.18;
  for(let i=dust.length-1;i>=0;i--){
    const p=dust[i];p.t+=dt;
    if(p.t>p.life){dust.splice(i,1);continue;}
    p.x+=p.vx*dt;p.y+=p.vy*dt;
    p.vx*=Math.exp(-3*dt);p.vy*=Math.exp(-3*dt);
  }
  for(let i=ripples.length-1;i>=0;i--){
    ripples[i].t+=dt/.55;
    if(ripples[i].t>=1)ripples.splice(i,1);
  }
  for(const m of motes){
    m.ph+=dt*.5;
    m.x+=(m.vx+Math.sin(m.ph)*3)*dt;m.y+=(m.vy+Math.cos(m.ph*.8)*3)*dt;
    if(m.x<-10)m.x=W+10;if(m.x>W+10)m.x=-10;
    if(m.y<-10)m.y=H+10;if(m.y>H+10)m.y=-10;
  }
  shake*=Math.exp(-7*dt);
  if(!hintOff&&(userMoves>=3||timeS>16)){hintOff=true;hintEl.classList.add('off');}

  ctx.setTransform(DPR,0,0,DPR,0,0);
  const shx=rnd(-1,1)*shake,shy=rnd(-1,1)*shake;
  ctx.fillStyle='#0c0805';ctx.fillRect(0,0,W,H);
  ctx.drawImage(floorC,shx,shy,W,H);
  const flick=.05+Math.sin(timeS*1.7)*.006+Math.sin(timeS*4.3)*.004;
  const lg=ctx.createRadialGradient(W*.5+shx,H*.42+shy,0,W*.5,H*.42,Math.max(W,H)*.62);
  lg.addColorStop(0,`rgba(255,206,150,${flick})`);
  lg.addColorStop(1,'rgba(255,206,150,0)');
  ctx.fillStyle=lg;ctx.fillRect(0,0,W,H);

  ctx.save();
  ctx.translate(OX+shx,OY+shy);
  for(const r of ripples){
    ctx.strokeStyle=`rgba(224,196,148,${(1-r.t)*(r.sand?.2:.22)})`;
    ctx.lineWidth=1.5;
    ctx.beginPath();ctx.arc(r.x,r.y,4+r.t*r.max,0,TAU);ctx.stroke();
  }
  const ccx=CI*CELL,ccy=CJ*CELL;
  for(const g of grains){
    ctx.globalAlpha=.3*clamp((g.r-CELL*.3)/(CELL*.6),0,1);
    ctx.fillStyle='#e0bd82';
    ctx.fillRect(ccx+Math.cos(g.a)*g.r-.6,ccy+Math.sin(g.a)*g.r-.6,1.2,1.2);
  }
  ctx.globalAlpha=1;
  const lx=ccx+Math.cos(lurkA)*CELL*.55,ly=ccy+Math.sin(lurkA)*CELL*.55;
  ctx.save();
  ctx.translate(lx,ly);ctx.rotate(lurkA+Math.PI/2);
  const ls=1+stir.s*.6;
  ctx.fillStyle=`rgba(0,0,0,${.24+stir.s*.18})`;
  ctx.beginPath();ctx.ellipse(0,0,CELL*.42*ls,CELL*.26*ls,0,0,TAU);ctx.fill();
  ctx.restore();
  for(const w of bars){
    ctx.globalAlpha=clamp((timeS*1.4-w.seed*.9)/.5,0,1);
    drawWall(w);
  }
  ctx.globalAlpha=1;
  drawHints();
  for(const p of pawns)drawPawn(p);
  for(const p of dust){
    ctx.globalAlpha=.55*(1-p.t/p.life);
    ctx.fillStyle='rgb(196,168,124)';
    ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,TAU);ctx.fill();
  }
  ctx.globalAlpha=1;
  ctx.restore();

  for(const m of motes){
    ctx.globalAlpha=m.a*(.7+.3*Math.sin(m.ph*2));
    ctx.fillStyle='rgb(226,200,158)';
    ctx.beginPath();ctx.arc(m.x,m.y,m.r,0,TAU);ctx.fill();
  }
  ctx.globalAlpha=1;

  ctx.drawImage(vigC,0,0,W,H);
  if(grainPat){
    ctx.save();ctx.globalAlpha=.05;ctx.fillStyle=grainPat;
    ctx.translate(-((timeS*57)%140),-((timeS*31)%140));
    ctx.fillRect(0,0,W+140,H+140);
    ctx.restore();
  }
}
resize();
requestAnimationFrame(frame);
</script>
