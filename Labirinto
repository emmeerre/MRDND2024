<body>
<canvas id="cv"></canvas>

<div id="hint">parete — <b>centrali</b> ruota 90° (dx/sx) · <b>estremi</b> scorrimento &nbsp;·&nbsp; pedina — <b>clic</b> seleziona · <b>frecce</b> muove · <b>trascina</b> libero · <b>tab</b> cambia</div>

<button id="btnAudio" aria-label="audio">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M11 5 6 9H2v6h4l5 4V5z"/>
    <path class="onda" d="M15.5 8.5a5 5 0 0 1 0 7"/>
    <path class="onda" d="M18.5 5.5a9 9 0 0 1 0 13"/>
    <line class="croce" x1="16" y1="9" x2="22" y2="15"/>
    <line class="croce" x1="22" y1="9" x2="16" y2="15"/>
  </svg>
</button>

<script>
'use strict';
/* ============================================================
   Labirinto a mura singole (1 casella) + pedine.
   Parete in 4 quarti: centrali = rotazione 90° (dx/sx),
   estremi = scorrimento longitudinale nel verso della zona.
   Una parete non ruota mai sopra una pedina; le pedine non
   attraversano i muri con le frecce; il drag è libero.
   ============================================================ */
const TAU=Math.PI*2;
const rnd=(a=1,b)=>b===undefined?Math.random()*a:a+Math.random()*(b-a);
const irand=n=>(Math.random()*n)|0;
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const hash=n=>{const x=Math.sin(n*127.1+311.7)*43758.5453;return x-Math.floor(x);};
const eob=(t,s=1.35)=>1+(s+1)*Math.pow(t-1,3)+s*Math.pow(t-1,2);
const eoc=t=>1-Math.pow(1-t,3);
const normAng=a=>{a=a%TAU;if(a>Math.PI)a-=TAU;if(a<-Math.PI)a+=TAU;return a;};
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;

const cv=document.getElementById('cv'), ctx=cv.getContext('2d');
let DPR=1,W=0,H=0;
let CELL=44,COLS=0,ROWS=0,OX=0,OY=0;
let CI=0,CJ=0;                    // centro del nido
const NEST_R=3;                   // raggio nido in caselle -> diametro 6
const CLEAR_R=NEST_R+1;           // fascia di rispetto dei MURI (le pedine entrano)
const ROT_HALF=0.25;              // metà-lunghezza della zona di rotazione
let WALL_T=12;
let occ=new Set(), bars=[];
let pawns=[], selP=null, dragP=null;
let dust=[],grains=[],ripples=[],motes=[];
let floorC=null,vigC=null,grainPat=null;
let wallSprites=[],shadowSpr=null;
let hover=null,shake=0,timeS=0;
let idleT=3.5,lastUser=-10,userMoves=0,hintOff=false;
let stir={t:rnd(5,9),s:0},lurkA=rnd(TAU);

/* ============================================================
   IMPOSTAZIONI MODIFICABILI
   ============================================================ */
const CELL_MIN=18, CELL_MAX=120;
const PROTEGGI_NIDO=true;         // false = il disegno ASCII può tenere muri vicino al nido
const CORNICE=1;                  // caselle vuote attorno al disegno ASCII

/* ============================================================
   PEDINE — modifica qui.
   · NUMERO: aggiungi o togli righe (una voce = una pedina)
   · COLORE: 'col' (qualsiasi colore CSS)
   · LETTERE (1-3): 'txt'
   · POSIZIONE DI PARTENZA: 'i' = colonna, 'j' = riga.
     Le coordinate sono quelle del CAMPO COMPLETO, che include
     la cornice vuota (CORNICE=1): quindi la casella (0,0) è
     l'angolo in alto a sinistra della cornice, e la prima
     casella del disegno ASCII corrisponde a (1,1).
     Cioè: casella disegnata (c,r) -> campo (c+1, r+1).
   Se la casella indicata è occupata da un'altra pedina (o è
   fuori campo) viene usata la più vicina libera; se ometti
   i/j la pedina parte dal centro e si sposta a spirale.
   ============================================================ */
const PEDINE=[
  {col:'#c9553e',txt:'DAG',  i:1, j:1 },
  {col:'#d6913c',txt:'NIK', i:11,j:1 },
  {col:'#cdb23e',txt:'BIN',i:21,j:1 },
  {col:'#84a83e',txt:'LEO',  i:37, j:9 },
  {col:'#4fa06b',txt:'BAA', i:37,j:1 },
  {col:'#4a9aa8',txt:'GRE',i:1, j:17},
  {col:'#5a80c0',txt:'LOR',  i:11,j:17},
  {col:'#8a70c0',txt:'HIL',i:31,j:17},
  {col:'#b56fa8',txt:'I',  i:28, j:17 },
  {col:'#a8546e',txt:'FL',i:19,j:9},
];

/* ============================================================
   CONFIGURAZIONE ASCII — disegna qui il tuo labirinto.
   "|" = muro verticale · "__" = muro orizzontale · spazio = via libera.
   La prima riga è il bordo superiore. Righe campo = righe testo - 1.
   Parser tollerante: passo e margine dedotti, scarti arrotondati.
   Stringa vuota '' = generazione casuale.
   ============================================================ */
const MAZE_ASCII =
`  _____________________________________________________________________________________________________________
 |     |   _____   |  |  |  |  |  |   ____________________   |  |  |  |     |  |     |     |     |     |     |  |
 |________|  |     |_____|  |  |_____|  |   _________________   |  |  |  |  |_____|_____|_____|_____|_____|___  |
 |___________|  |___________|  |   _____|  |   ___________   |  |  |  |  |  |  ________________________________ |
 |   ___________|   ___________|  |  ______|  |   ________|  |_____|  |  |  |_________________________________  |
 |  |   ___________|   ___________|___________|  |___________|     |  |  |  |  ________________________________ |
 |  |  |   __         |   _________________   |_____   |     |  |  |  |  |  |_________________________________  |
 |  |  |  |  |  |  |  |  |   ______________|_____   |  |  |  |  |  |  |__|  |  ________________________________ |
 |  |  |  |  |  |  |_____|  |   _____   |   __   |  |  |  |  |  |  |________|_________________________________  |
 |  |  |  |  |___________|  |     |  |  |  |  |  |  |  |  |  |  |  |      __      |   ____________     |        |
 |  |  |  |  |_________________|  |  |  |  |  |  |  |  |  |  |  |  |   __|  |__   |  |   ______  |     |   __|  |
 |  |  |  |  |  |   __    ______________|  |  |  |  |   __|  |  |  |  |__    __|  |  |  |     |  |     |__|     |
 |  |  |  |  |  |  |  |  |   ________   |  |  |  |  |  |  |  |  |  |_____|  |_____|  |  |  |  |  |   __|   __|  |
 |  |  |  |  |  |  |  |  |  |   _____   |  |  |  |  | ____|  |  |   _____    _____   |  |  |  |  |  |   __|     | 
 |  |  |  |  |  |  |  |  |  |  |  ______|  |  |  |  |   ________|  |   __|  |__   |  |  |  |  |  |   __|   __|  |
 |  |  |_____|  |  |  |  |  |  |_____   |  |  |  |  |  |      __   |  |__    __|  |  |  |  |__|  |  |   __|     | 
 |  |_____   |  |__|  |  |  |________|  |  |  |  |__|  |  |__|  |  |     |__|     |  |  |________|   __|   __|  |
 |___________|_______________________|________|________|___________|______________|__|______________|_____|_____|`;
const FILL_PAGE=true;

/* ---------- geometria del reticolo ---------- */
const K=(o,i,j)=>o+i+','+j;
function endpoints(o,i,j){return o==='h'?[i,j,i+1,j]:[i,j,i,j+1];}
function segDist(px,py,ax,ay,bx,by){
  const dx=bx-ax,dy=by-ay;
  const t=clamp(((px-ax)*dx+(py-ay)*dy)/(dx*dx+dy*dy),0,1);
  return Math.hypot(px-(ax+t*dx),py-(ay+t*dy));
}
function inBounds(o,i,j){
  return o==='h'?(i>=0&&i<COLS&&j>=0&&j<=ROWS)
                :(i>=0&&i<=COLS&&j>=0&&j<ROWS);
}
function nearNest(o,i,j){
  const [ax,ay,bx,by]=endpoints(o,i,j);
  return segDist(CI,CJ,ax,ay,bx,by)<CLEAR_R-1e-4;
}
function freeSpot(o,i,j,protNido){
  if(!inBounds(o,i,j))return false;
  if(occ.has(K(o,i,j)))return false;
  if(protNido&&nearNest(o,i,j))return false;
  return true;
}

/* ---------- parser del disegno ASCII (tollerante) ---------- */
function parseASCII(src){
  const L=src.replace(/\r/g,'').split('\n');
  while(L.length&&L[0].replace(/[^_|]/g,'').trim()==='')L.shift();
  while(L.length&&L[L.length-1].replace(/[^_|]/g,'').trim()==='')L.pop();
  const out={cols:0,rows:0,walls:new Set()};
  if(!L.length)return out;
  const gcd=(a,b)=>b?gcd(b,a%b):a;
  let PITCH=0;
  for(const ln of L){
    let prev=-1;
    for(let p=ln.indexOf('|');p>=0;p=ln.indexOf('|',p+1)){
      if(prev>=0&&p-prev>=2)PITCH=PITCH?gcd(PITCH,p-prev):p-prev;
      prev=p;
    }
  }
  if(PITCH<2||PITCH>10)PITCH=3;
  const resid={};
  for(const ln of L)
    for(let p=ln.indexOf('|');p>=0;p=ln.indexOf('|',p+1))
      resid[p%PITCH]=(resid[p%PITCH]||0)+1;
  let R=0,best=0;
  for(const k in resid)if(resid[k]>best){best=resid[k];R=+k;}
  let left=Infinity;
  for(const ln of L)
    for(let p=ln.indexOf('|');p>=0;p=ln.indexOf('|',p+1))
      if(p%PITCH===R&&p<left)left=p;
  if(!isFinite(left))left=0;
  const colV=p=>Math.round((p-left)/PITCH);
  const colH=p=>Math.round((p-left-(PITCH-1)/2)/PITCH);
  let maxC=0;
  for(const ln of L){
    for(let p=ln.indexOf('|');p>=0;p=ln.indexOf('|',p+1))maxC=Math.max(maxC,colV(p));
    for(let p=ln.indexOf('_');p>=0;p=ln.indexOf('_',p+1))maxC=Math.max(maxC,colH(p)+1);
  }
  out.cols=Math.max(1,maxC);
  out.rows=Math.max(1,L.length-1);
  const addH=(c,j)=>{if(c>=0&&c<out.cols&&j>=0&&j<=out.rows)out.walls.add('h'+c+','+j);};
  const addV=(c,j)=>{if(c>=0&&c<=out.cols&&j>=0&&j<out.rows)out.walls.add('v'+c+','+j);};
  for(let p=L[0].indexOf('_');p>=0;p=L[0].indexOf('_',p+1))addH(colH(p),0);
  for(let r=1;r<L.length;r++){
    const ln=L[r],j=r-1;
    for(let p=ln.indexOf('|');p>=0;p=ln.indexOf('|',p+1))addV(colV(p),j);
    for(let p=ln.indexOf('_');p>=0;p=ln.indexOf('_',p+1))addH(colH(p),j+1);
  }
  return out;
}

/* ---------- generazione casuale (solo se il disegno è vuoto) ---------- */
function genMaze(){
  occ.clear();bars.length=0;
  const nE=COLS*(ROWS+1)+ROWS*(COLS+1);
  const target=Math.round(nE*0.23);
  let guard=0;
  while(bars.length<target&&guard++<target*80){
    const o=Math.random()<.5?'h':'v';
    let i,j;
    if(o==='h'){i=irand(COLS);j=irand(ROWS+1);}
    else{i=irand(COLS+1);j=irand(ROWS);}
    if(!freeSpot(o,i,j,true))continue;
    occ.add(K(o,i,j));
    bars.push({o,i,j,x:i+(o==='h'?.5:0),y:j+(o==='v'?.5:0),
               anim:null,shud:0,v:irand(3),seed:Math.random()});
  }
}
function buildWalls(art,padL,padT){
  occ.clear();bars.length=0;
  for(const key of art.walls){
    const o=key[0],ab=key.slice(1).split(',');
    const i=+ab[0]+padL,j=+ab[1]+padT;
    if(!freeSpot(o,i,j,PROTEGGI_NIDO))continue;
    occ.add(K(o,i,j));
    bars.push({o,i,j,x:o==='h'?i+.5:i,y:o==='h'?j:j+.5,
               anim:null,shud:0,v:irand(3),seed:Math.random()});
  }
  console.log('Pareti dal disegno ASCII: '+bars.length);
}

/* ---------- pedine ---------- */
function nearestFreeCell(i,j,taken){
  const t2=new Set(taken.map(p=>p.i+','+p.j));
  if(!t2.has(i+','+j))return[i,j];
  for(let r=1;r<Math.max(COLS,ROWS);r++)
    for(let dj=-r;dj<=r;dj++)for(let di=-r;di<=r;di++){
      if(Math.max(Math.abs(di),Math.abs(dj))!==r)continue;
      const ni=i+di,nj=j+dj;
      if(ni<0||ni>=COLS||nj<0||nj>=ROWS)continue;
      if(!t2.has(ni+','+nj))return[ni,nj];
    }
  return[i,j];
}
function spawnPawns(){
  pawns.length=0;selP=null;
  const taken=[];
  for(let k=0;k<PEDINE.length;k++){
    const d=PEDINE[k];
    let i,j;
    if(Number.isInteger(d.i)&&Number.isInteger(d.j)){
      i=clamp(d.i,0,COLS-1);j=clamp(d.j,0,ROWS-1);
    }else{
      /* senza coordinate: parte dal centro, poi a spirale */
      i=clamp(Math.round(CI-.5),0,COLS-1);
      j=clamp(Math.round(CJ-.5),0,ROWS-1);
    }
    [i,j]=nearestFreeCell(i,j,taken);
    const p={def:d,i,j,fx:i+.5,fy:j+.5,anim:null,bump:null};
    taken.push(p);pawns.push(p);
  }
}
/* un muro in rotazione passa sopra questa pedina? */
function rotPawnBlock(hx,hy,a1,dir){
  for(const p of pawns){
    if(p===dragP&&dragP)continue;
    const dx=p.i+.5-hx,dy=p.j+.5-hy;
    const d=Math.hypot(dx,dy);
    if(d>1.35)continue;
    const t=dir*normAng(Math.atan2(dy,dx)-a1);
    const hA=Math.asin(Math.min(1,0.36/Math.max(d,0.25)));
    if(t>=-hA-0.15&&t<=Math.PI/2+hA+0.15)return true;
  }
  return false;
}
function tryMovePawn(p,dx,dy){
  if(p.anim||dragP)return;
  const ni=p.i+dx,nj=p.j+dy;
  let block=false;
  if(ni<0||ni>=COLS||nj<0||nj>=ROWS)block=true;
  else if(dx===-1&&occ.has(K('v',p.i,p.j)))block=true;      /* bordo sx */
  else if(dx===1 &&occ.has(K('v',p.i+1,p.j)))block=true;    /* bordo dx */
  else if(dy===-1&&occ.has(K('h',p.i,p.j)))block=true;      /* bordo sup */
  else if(dy===1 &&occ.has(K('h',p.i,p.j+1)))block=true;    /* bordo inf */
  else if(pawns.some(q=>q!==p&&q.i===ni&&q.j===nj))block=true;
  else for(const w of bars)
    if(w.anim&&w.anim.type==='rot'&&w.anim.cells&&w.anim.cells.includes(ni+','+nj)){block=true;break;}
  if(block){p.bump={dx,dy,t:0};return;}
  p.anim={fx:p.i+.5,fy:p.j+.5,tx:ni+.5,ty:nj+.5,t:0,dur:.11};
  p.i=ni;p.j=nj;
  sfx.tick();
}

/* ---------- mosse delle pareti ---------- */
function rotateTarget(o,i,j,cw,hingeA){
  if(o==='h'){
    if(cw)  return hingeA?{ax:i,  ay:j,o:'v',i:i,  j:j}  :{ax:i+1,ay:j,o:'v',i:i+1,j:j-1};
    else    return hingeA?{ax:i,  ay:j,o:'v',i:i,  j:j-1}:{ax:i+1,ay:j,o:'v',i:i+1,j:j};
  }else{
    if(cw)  return hingeA?{ax:i,  ay:j,o:'h',i:i-1,j:j}  :{ax:i,  ay:j+1,o:'h',i:i,j:j+1};
    else    return hingeA?{ax:i,  ay:j,o:'h',i:i,  j:j}  :{ax:i,  ay:j+1,o:'h',i:i-1,j:j+1};
  }
}
function tryRotate(w,cw,vol,hingeA){
  const T=rotateTarget(w.o,w.i,w.j,cw,hingeA);
  if(!freeSpot(T.o,T.i,T.j,true))return false;
  /* nessuna rotazione sopra una pedina */
  const [x1,y1,x2,y2]=endpoints(w.o,w.i,w.j);
  const hx=hingeA?x1:x2,hy=hingeA?y1:y2;
  const ox=hingeA?x2:x1,oy=hingeA?y2:y1;
  if(rotPawnBlock(hx,hy,Math.atan2(oy-hy,ox-hx),cw?1:-1))return false;
  const wasO=w.o,wasI=w.i,wasJ=w.j;
  occ.delete(K(w.o,w.i,w.j));occ.add(K(T.o,T.i,T.j));
  /* celle toccate dall'arco: le pedine non possono entrarci durante l'animazione */
  const cs=new Set();
  const add=(a,b)=>{if(a>=0&&a<COLS&&b>=0&&b<ROWS)cs.add(a+','+b);};
  if(wasO==='h'){add(wasI,wasJ-1);add(wasI,wasJ);}else{add(wasI-1,wasJ);add(wasI,wasJ);}
  if(T.o==='h'){add(T.i,T.j-1);add(T.i,T.j);}else{add(T.i-1,T.j);add(T.i,T.j);}
  w.anim={type:'rot',t:0,dur:.3,cw,ax:T.ax,ay:T.ay,
          sx:w.x,sy:w.y,sa:wasO==='h'?0:Math.PI/2,vol,cells:[...cs]};
  w.o=T.o;w.i=T.i;w.j=T.j;
  w.x=(w.o==='h')?T.i+.5:T.i;
  w.y=(w.o==='h')?T.j:T.j+.5;
  sfx.grind(vol);
  return true;
}
function trySlide(w,dir,vol){
  const ni=w.o==='h'?w.i+dir:w.i;
  const nj=w.o==='v'?w.j+dir:w.j;
  if(!freeSpot(w.o,ni,nj,true))return false;
  occ.delete(K(w.o,w.i,w.j));occ.add(K(w.o,ni,nj));
  w.anim={type:'slide',t:0,dur:.17,fx:w.x,fy:w.y,vol};
  w.i=ni;w.j=nj;
  if(w.o==='h')w.x=ni+.5;else w.y=nj+.5;
  sfx.scrape(vol);
  return true;
}
function blocked(w){
  w.shud=1;sfx.knock();addShake(1.8);
  dustAtEnds(w,3);
}
function dustAtEnds(w,n){
  const [ax,ay,bx,by]=endpoints(w.o,w.i,w.j);
  dustAt(ax*CELL,ay*CELL,n);dustAt(bx*CELL,by*CELL,n);
}
function addShake(v){if(!RM)shake=Math.max(shake,v);}
function wallXform(w){
  if(!w.anim)return{x:w.x,y:w.y,ang:w.o==='h'?0:Math.PI/2};
  const A=w.anim,e=eob(clamp(A.t,0,1));
  if(A.type==='slide')
    return{x:A.fx+(w.x-A.fx)*e,y:A.fy+(w.y-A.fy)*e,ang:w.o==='h'?0:Math.PI/2};
  const th=(A.cw?1:-1)*Math.PI/2*e,dx=A.sx-A.ax,dy=A.sy-A.ay;
  return{x:A.ax+dx*Math.cos(th)-dy*Math.sin(th),
         y:A.ay+dx*Math.sin(th)+dy*Math.cos(th),
         ang:A.sa+th};
}

/* ---------- audio sintetizzato ---------- */
const sfx=(()=>{
  let ac=null,master=null,nbuf=null,muted=false;
  function ensure(){
    if(!ac){
      const AC=window.AudioContext||window.webkitAudioContext;
      if(!AC)return;
      ac=new AC();
      master=ac.createGain();master.gain.value=.4;master.connect(ac.destination);
      const n=ac.sampleRate*1.1,buf=ac.createBuffer(1,n,ac.sampleRate),d=buf.getChannelData(0);
      let l=0;for(let i=0;i<n;i++){const w=Math.random()*2-1;l=(l+.03*w)/1.03;d[i]=l*3.2;}
      nbuf=buf;
    }
    if(ac.state==='suspended')ac.resume();
  }
  function noise(dur,f0,f1,type,vol,delay=0){
    if(!ac||muted)return;
    const t=ac.currentTime+delay;
    const s=ac.createBufferSource();s.buffer=nbuf;s.loop=true;
    const f=ac.createBiquadFilter();f.type=type;f.Q.value=1.1;
    f.frequency.setValueAtTime(f0,t);
    f.frequency.exponentialRampToValueAtTime(Math.max(30,f1),t+dur);
    const g=ac.createGain();
    g.gain.setValueAtTime(0,t);
    g.gain.linearRampToValueAtTime(vol,t+.02);
    g.gain.exponentialRampToValueAtTime(.0008,t+dur);
    s.connect(f);f.connect(g);g.connect(master);
    s.start(t);s.stop(t+dur+.05);
  }
  function tone(dur,f0,f1,vol,delay=0,type='sine'){
    if(!ac||muted)return;
    const t=ac.currentTime+delay;
    const o=ac.createOscillator();o.type=type;
    o.frequency.setValueAtTime(f0,t);
    o.frequency.exponentialRampToValueAtTime(f1,t+dur);
    const g=ac.createGain();
    g.gain.setValueAtTime(vol,t);
    g.gain.exponentialRampToValueAtTime(.0008,t+dur);
    o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+.05);
  }
  return{
    ensure,
    toggle(){muted=!muted;return muted;},
    scrape(v){noise(.22,650,150,'bandpass',.4*v);},
    grind(v){noise(.4,300,75,'lowpass',.5*v);noise(.32,520,190,'bandpass',.2*v);},
    clack(v){tone(.09,115,52,.32*v);noise(.05,1400,700,'highpass',.2*v);},
    knock(){tone(.13,72,38,.4);noise(.09,240,110,'lowpass',.2);},
    sand(){noise(.5,500,140,'lowpass',.12);},
    tick(){tone(.06,520,300,.13,0,'triangle');}
  };
})();

/* ---------- sprite dei muri ---------- */
function rr(g,x,y,w,h,r){
  g.beginPath();
  g.moveTo(x+r,y);
  g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);
  g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);
  g.closePath();
}
function bakeWallSprites(){
  wallSprites=[];
  for(let v=0;v<3;v++){
    const L=CELL+2,T=WALL_T,PAD=8;
    const c=document.createElement('canvas');
    c.width=Math.ceil((L+PAD*2)*DPR);c.height=Math.ceil((T+PAD*2)*DPR);
    const g=c.getContext('2d');g.scale(DPR,DPR);g.translate(PAD+L/2,PAD+T/2);
    rr(g,-L/2,-T/2,L,T,3);
    g.fillStyle=`hsl(${28+v*4},${14+v*2}%,${23+v*2.5}%)`;
    g.fill();
    g.save();rr(g,-L/2,-T/2,L,T,3);g.clip();
    const jx=(v-1)*CELL*.14;
    g.strokeStyle='rgba(0,0,0,.45)';g.lineWidth=1.2;
    g.beginPath();g.moveTo(jx,-T/2);g.lineTo(jx,T/2);g.stroke();
    g.strokeStyle='rgba(0,0,0,.14)';
    g.beginPath();g.moveTo(-L/2,-T*.08+(v-1)*2);g.lineTo(L/2,-T*.08+(v-1)*2);g.stroke();
    g.fillStyle='rgba(255,238,200,.14)';g.fillRect(-L/2,-T/2,L,2);
    g.fillStyle='rgba(255,238,200,.05)';g.fillRect(-L/2,-T/2+2,L,1.4);
    g.fillStyle='rgba(0,0,0,.34)';g.fillRect(-L/2,T/2-2.4,L,2.4);
    for(let i=0;i<CELL*.55;i++){
      const s1=hash(i*3.7+v*57.2),s2=hash(i*8.3+v*11.9);
      g.fillStyle=s1>.5?'rgba(255,240,210,.1)':'rgba(0,0,0,.22)';
      g.fillRect(-L/2+s1*L,-T/2+2+s2*(T-4),1.3,1.3);
    }
    let cg=g.createLinearGradient(-L/2,0,-L/2+6,0);
    cg.addColorStop(0,'rgba(0,0,0,.32)');cg.addColorStop(1,'rgba(0,0,0,0)');
    g.fillStyle=cg;g.fillRect(-L/2,-T/2,6,T);
    cg=g.createLinearGradient(L/2,0,L/2-6,0);
    cg.addColorStop(0,'rgba(0,0,0,.32)');cg.addColorStop(1,'rgba(0,0,0,0)');
    g.fillStyle=cg;g.fillRect(L/2-6,-T/2,6,T);
    g.restore();
    rr(g,-L/2,-T/2,L,T,3);
    g.strokeStyle='rgba(0,0,0,.5)';g.lineWidth=1;g.stroke();
    wallSprites.push(c);
  }
  const L=CELL+2,T=WALL_T,PAD=14;
  shadowSpr=document.createElement('canvas');
  shadowSpr.width=Math.ceil((L+PAD*2)*DPR);shadowSpr.height=Math.ceil((T+PAD*2+8)*DPR);
  const g=shadowSpr.getContext('2d');g.scale(DPR,DPR);
  g.filter='blur(4px)';
  g.fillStyle='rgba(0,0,0,.42)';
  rr(g,PAD+3,PAD+4,L,T,3);g.fill();
  g.filter='none';
}

/* ---------- pavimento + nido ---------- */
function buildFloor(){
  floorC=document.createElement('canvas');
  floorC.width=Math.ceil(W*DPR);floorC.height=Math.ceil(H*DPR);
  const g=floorC.getContext('2d');g.scale(DPR,DPR);
  g.fillStyle='#0c0805';g.fillRect(0,0,W,H);
  for(let gy=-2;gy<ROWS+2;gy++)for(let gx=-2;gx<COLS+2;gx++){
    const h=hash(gx*7.31+gy*3.77),h2=hash(gx*13.1+gy*29.3);
    const x=OX+gx*CELL,y=OY+gy*CELL;
    g.fillStyle=`hsl(${26+h*10},${11+h2*6}%,${7.5+h*3.2}%)`;
    g.fillRect(x+1,y+1,CELL-2,CELL-2);
    g.strokeStyle='rgba(0,0,0,.4)';g.lineWidth=1;
    g.strokeRect(x+1.5,y+1.5,CELL-3,CELL-3);
    g.strokeStyle='rgba(255,235,200,.028)';
    g.strokeRect(x+2.5,y+2.5,CELL-5,CELL-5);
    if(h2>.9){
      g.strokeStyle='rgba(0,0,0,.35)';g.beginPath();
      let px=x+rnd(CELL*.2,CELL*.8),py=y+rnd(CELL*.2,CELL*.8);
      g.moveTo(px,py);
      for(let k=0;k<3;k++){px+=rnd(-CELL*.25,CELL*.25);py+=rnd(-CELL*.25,CELL*.25);g.lineTo(px,py);}
      g.stroke();
    }
  }
  bakeCrater(g);
  for(let i=0;i<8;i++){
    const x=rnd(W),y=rnd(H),r=rnd(120,320);
    const mg=g.createRadialGradient(x,y,0,x,y,r);
    mg.addColorStop(0,i%2?'rgba(0,0,0,.12)':'rgba(255,225,175,.02)');
    mg.addColorStop(1,'rgba(0,0,0,0)');
    g.fillStyle=mg;g.fillRect(x-r,y-r,r*2,r*2);
  }
}
function bakeCrater(g){
  const cx=OX+CI*CELL,cy=OY+CJ*CELL,R=NEST_R*CELL;
  for(let k=0;k<160;k++){
    const a=rnd(TAU),r=R*(1+Math.pow(rnd(),2)*.14);
    g.fillStyle=`rgba(190,150,95,${rnd(.08,.3)})`;
    g.beginPath();g.arc(cx+Math.cos(a)*r,cy+Math.sin(a)*r,rnd(.6,2),0,TAU);g.fill();
  }
  const gr=g.createRadialGradient(cx,cy,0,cx,cy,R);
  gr.addColorStop(0,'#070402');gr.addColorStop(.3,'#1c1107');
  gr.addColorStop(.55,'#3c2a13');gr.addColorStop(.78,'#6d4d27');
  gr.addColorStop(.92,'#9a7440');gr.addColorStop(1,'#b98f52');
  g.beginPath();g.arc(cx,cy,R,0,TAU);g.fillStyle=gr;g.fill();
  for(let r=R*.14;r<R*.95;r+=R*.085){
    g.strokeStyle=`rgba(0,0,0,${.16*(1-r/R)})`;g.lineWidth=1.2;
    g.beginPath();g.arc(cx,cy,r+Math.sin(r*3.1)*.8,0,TAU);g.stroke();
    if(((r/R*10)|0)%3===0){
      g.strokeStyle='rgba(255,225,170,.05)';
      g.beginPath();g.arc(cx,cy,r-1.5,0,TAU);g.stroke();
    }
  }
  for(let k=0;k<240;k++){
    const a=rnd(TAU),r=R*Math.sqrt(rnd())*.95;
    g.fillStyle=k%2?'rgba(0,0,0,.18)':'rgba(255,235,190,.1)';
    g.fillRect(cx+Math.cos(a)*r,cy+Math.sin(a)*r,1.2,1.2);
  }
  g.strokeStyle='rgba(255,230,180,.22)';g.lineWidth=1.5;
  g.beginPath();g.arc(cx,cy,R-.5,0,TAU);g.stroke();
  g.strokeStyle='rgba(0,0,0,.25)';
  g.beginPath();g.arc(cx,cy,R*.985,0,TAU);g.stroke();
  for(let k=0;k<12;k++){
    const a=rnd(TAU),r=R*rnd(.3,.9);
    const x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r,s=rnd(1.5,3.2);
    g.fillStyle='#2a1d10';g.beginPath();g.arc(x,y,s,0,TAU);g.fill();
    g.fillStyle='rgba(255,235,190,.15)';g.beginPath();g.arc(x-s*.3,y-s*.3,s*.4,0,TAU);g.fill();
  }
  for(let k=0;k<8;k++){
    const a=k/8*TAU+rnd(-.2,.2);
    g.strokeStyle='rgba(0,0,0,.3)';g.lineWidth=1;
    g.beginPath();
    g.moveTo(cx+Math.cos(a)*(R+2),cy+Math.sin(a)*(R+2));
    g.lineTo(cx+Math.cos(a+rnd(-.12,.12))*(R+rnd(CELL*.3,CELL*.8)),
             cy+Math.sin(a+rnd(-.12,.12))*(R+rnd(CELL*.3,CELL*.8)));
    g.stroke();
  }
  const hr=R*.17;
  const hg=g.createRadialGradient(cx,cy,0,cx,cy,hr);
  hg.addColorStop(0,'#000');hg.addColorStop(.8,'rgba(0,0,0,.9)');hg.addColorStop(1,'rgba(0,0,0,0)');
  g.beginPath();g.arc(cx,cy,hr,0,TAU);g.fillStyle=hg;g.fill();
}
function buildVig(){
