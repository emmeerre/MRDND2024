/* ---------- ridimensionamento ---------- */
function resize(){
  DPR=Math.min(window.devicePixelRatio||1,2);
  W=window.innerWidth;H=window.innerHeight;
  cv.width=Math.ceil(W*DPR);cv.height=Math.ceil(H*DPR);
  cv.style.width=W+'px';cv.style.height=H+'px';

  const art=parseASCII(MAZE_ASCII);
  const usaArte=art.walls.size>0&&art.cols>0&&art.rows>0;
  let padL=0,padT=0;
  if(usaArte){
    const c0=art.cols+2*CORNICE,r0=art.rows+2*CORNICE;
    let padC=0,padR=0;
    if(FILL_PAGE){
      const A=W/H,cur=c0/r0;
      if(cur<A)padC=Math.max(0,Math.round(r0*A)-c0);
      else     padR=Math.max(0,Math.round(c0/A)-r0);
    }
    COLS=c0+padC;ROWS=r0+padR;
    CELL=clamp(Math.min(W/COLS,H/ROWS),CELL_MIN,CELL_MAX);
    OX=Math.round((W-COLS*CELL)/2);OY=Math.round((H-ROWS*CELL)/2);
    padL=CORNICE+Math.floor(padC/2);
    padT=CORNICE+Math.floor(padR/2);
  }else{
    CELL=clamp(Math.min(W,H)/16,28,46);
    COLS=2*Math.max(5,Math.round(W/(2*CELL)));
    ROWS=2*Math.max(5,Math.round(H/(2*CELL)));
    OX=Math.round((W-COLS*CELL)/2);OY=Math.round((H-ROWS*CELL)/2);
  }
  CI=COLS/2;CJ=ROWS/2;
  WALL_T=Math.round(CELL*.27);
  bakeWallSprites();buildFloor();buildVig();buildGrain();
  if(usaArte)buildWalls(art,padL,padT);else genMaze();

  /* pedine: se esistono già si riallocano, altrimenti si generano */
  if(pawns.length){
    const taken=[];
    for(const p of pawns){
      p.i=clamp(p.i,0,COLS-1);p.j=clamp(p.j,0,ROWS-1);
      [p.i,p.j]=nearestFreeCell(p.i,p.j,taken);
      taken.push(p);
      p.fx=p.i+.5;p.fy=p.j+.5;p.anim=null;p.bump=null;
    }
  }else spawnPawns();

  grains=Array.from({length:30},()=>({a:rnd(TAU),r:rnd(.25,.95)*NEST_R*CELL,sp:rnd(4,10)}));
  motes=Array.from({length:26},()=>({x:rnd(W),y:rnd(H),vx:rnd(-6,6),vy:rnd(-4,4),
    ph:rnd(TAU),r:rnd(.6,1.6),a:rnd(.04,.1)}));
  hover=null;
}
