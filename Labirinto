/* ---------- disegno ---------- */
function drawWall(w){
  const X=wallXform(w);
  let x=X.x,y=X.y;
  if(w.shud>0){
    const s=Math.sin(timeS*55)*2.2*w.shud;
    x+=Math.cos(X.ang+Math.PI/2)*s/CELL;
    y+=Math.sin(X.ang+Math.PI/2)*s/CELL;
  }
  const spr=wallSprites[w.v];
  const dw=spr.width/DPR,dh=spr.height/DPR;
  ctx.save();
  ctx.translate(x*CELL,y*CELL+4);
  ctx.rotate(X.ang);
  ctx.drawImage(shadowSpr,-shadowSpr.width/(2*DPR),-shadowSpr.height/(2*DPR),
                shadowSpr.width/DPR,shadowSpr.height/DPR);
  ctx.restore();
  ctx.save();
  ctx.translate(x*CELL,y*CELL);
  ctx.rotate(X.ang);
  ctx.drawImage(spr,-dw/2,-dh/2,dw,dh);
  ctx.restore();
}
function drawHints(){
  if(!hover)return;
  const w=hover.w;if(w.anim)return;
  const X=wallXform(w);
  const L=CELL,T=WALL_T;
  ctx.save();
  ctx.translate(X.x*CELL,X.y*CELL);
